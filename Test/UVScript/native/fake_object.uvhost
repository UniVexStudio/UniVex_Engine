# The node FakeHostUVE in uvscript_vm_uve_tests.cpp pretends to be. Keep the two in step: a script
# compiled against a different description gets a different fingerprint and runs interpreted.
property velocity vec3
property grounded bool readonly
property health int
function input.axis(str, str) -> float
function node(str) -> Object3D
event ready()
event tick(float)
event body_entered(Object3D)
