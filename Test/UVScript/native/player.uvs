entity Player : CharacterBody3D
export speed: float = 6.0
export jump = 2.0 m
var jumps = 0

on ready:
    print("{jumps} jumps, speed {speed}")

on tick(dt):
    velocity.x = input.axis("left", "right") * speed
    if is_on_floor:
        velocity.y = sqrt(2.0 * 9.8 * jump)
        jumps += 1
    else:
        velocity.y -= 9.8 * dt
